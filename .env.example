# MaintAI Studio — environment template (demo defaults only; NO real secrets)
# Copy to `.env` and override for local runs. Docker Compose also reads `.env`.

# LLM provider (mock = offline default; openai-compatible via env when set)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# P1 human-approval gate bearer token. Environment-only; this is a LOCAL DEMO
# token, NOT an enterprise identity. Replace with a strong random value before
# any shared/production use. Unset => approval decision endpoints return 503.
APPROVAL_API_TOKEN=change-me-demo-approval-token

# Business database (Postgres; host `postgres` resolves inside compose network)
POSTGRES_PASSWORD=maintai-demo-local-change-me
DATABASE_URL=postgresql+psycopg://maintai:maintai-demo-local-change-me@postgres:5432/maintai

# MLflow tracking/registry
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=maintai-p0

# Controlled dataset storage root inside the API container
DATASET_STORAGE_PATH=/app/data/uploads

# Controlled model artifact root inside the API container (named volume)
ARTIFACT_STORAGE_PATH=/app/artifacts
